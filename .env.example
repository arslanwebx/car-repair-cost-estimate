# Runtime configuration for AI photo analysis. AI_API_KEY is preferred;
# OPENAI_API_KEY is a supported alias. Store either key as an encrypted secret.
AI_PROVIDER=openai
AI_API_KEY=
AI_VISION_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Runtime contact configuration. Store RESEND_API_KEY as an encrypted secret.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Carspect Website <website@carspect.pro>

# Public values embedded during the Next.js build; these are not secrets.
NEXT_PUBLIC_SITE_URL=https://carspect.pro
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-H01GDSV01X

# Optional runtime and privacy-policy tuning; these are not secrets.
PHOTO_RETENTION_HOURS=24
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=60

# Build setting; safe to expose.
NEXT_TELEMETRY_DISABLED=1
